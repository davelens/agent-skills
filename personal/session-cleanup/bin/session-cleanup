#!/usr/bin/env python3
"""Inspect and safely apply Pi session cleanup decisions."""

import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import subprocess
import sys


SKILL_TAG = re.compile(r'<skill\b[^>]*>|</skill>', re.IGNORECASE)
PATH_TOKEN = re.compile(r'(?<![\w.-])(?:/|\.{1,2}/)[^\s\'"`;,)}\]]+')


def fail(message):
    raise SystemExit(message)


def session_context():
    raw = os.environ.get('PI_SESSION_FILE')
    if not raw:
        fail('PI_SESSION_FILE is unset')

    current = Path(raw).expanduser()
    directory = current.parent
    if not directory.is_dir():
        fail(f'Session directory does not exist: {directory}')
    if current.suffix != '.jsonl' or not current.is_file():
        fail(f'Current session is not a JSONL file: {current}')

    return directory, current


def strip_skill_blocks(text):
    output = []
    depth = 0
    cursor = 0

    for match in SKILL_TAG.finditer(text):
        closing = match.group(0).lower().startswith('</')
        if not closing:
            if depth == 0:
                output.append(text[cursor:match.start()])
            depth += 1
        elif depth:
            depth -= 1
            if depth == 0:
                cursor = match.end()

    if depth == 0:
        output.append(text[cursor:])

    return ''.join(output).strip()


def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for child in value.values():
            yield from strings(child)
    elif isinstance(value, list):
        for child in value:
            yield from strings(child)


def relevant_paths(arguments):
    paths = []
    for value in strings(arguments):
        paths.extend(PATH_TOKEN.findall(value))
    return list(dict.fromkeys(paths))


def parse_session(path, include_content=True):
    before = path.stat()
    data = path.read_bytes()
    after = path.stat()
    if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
        raise RuntimeError('changed during inspection')

    latest_name = ''
    latest_id = None
    user_texts = []
    assistant_texts = []
    tool_calls = []

    for number, raw_line in enumerate(data.splitlines(), 1):
        try:
            record = json.loads(raw_line)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RuntimeError(f'invalid JSONL at line {number}: {error}') from error

        latest_id = record.get('id') or latest_id
        if record.get('type') == 'session_info':
            name = record.get('name')
            latest_name = name.strip() if isinstance(name, str) else ''

        if not include_content or record.get('type') != 'message':
            continue

        message = record.get('message', {})
        role = message.get('role')
        content = message.get('content', [])
        if isinstance(content, str):
            content = [{'type': 'text', 'text': content}]

        for item in content:
            if not isinstance(item, dict):
                continue
            if item.get('type') == 'text':
                text = item.get('text', '')
                if role == 'user':
                    text = strip_skill_blocks(text)
                    if text:
                        user_texts.append(text)
                elif role == 'assistant' and text.strip():
                    assistant_texts.append(text.strip())
            elif role == 'assistant' and item.get('type') == 'toolCall':
                tool_calls.append({
                    'name': item.get('name', ''),
                    'paths': relevant_paths(item.get('arguments', {})),
                })

    return {
        'file': path.name,
        'size': before.st_size,
        'mtime_ns': before.st_mtime_ns,
        'sha256': hashlib.sha256(data).hexdigest(),
        'latest_id': latest_id,
        'name': latest_name,
        'user_texts': user_texts,
        'assistant_texts': assistant_texts,
        'tool_calls': tool_calls,
    }


def inspect_sessions(pretty=False):
    directory, current = session_context()
    unnamed = []
    uncertain = []
    named_count = 0

    for path in sorted(directory.glob('*.jsonl')):
        try:
            metadata = parse_session(path, include_content=False)
            if metadata['name']:
                named_count += 1
                continue
            session = parse_session(path)
            if session['name']:
                named_count += 1
                continue
        except (OSError, RuntimeError) as error:
            uncertain.append({'file': path.name, 'reason': str(error)})
            continue

        session.pop('name')
        session['current'] = path == current
        unnamed.append(session)

    result = {
        'session_dir': str(directory),
        'current': current.name,
        'named_excluded': named_count,
        'unnamed': unnamed,
        'uncertain': uncertain,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2 if pretty else None))


def candidate_path(directory, filename):
    if not isinstance(filename, str) or Path(filename).name != filename or not filename.endswith('.jsonl'):
        raise ValueError(f'Invalid session filename: {filename!r}')
    return directory / filename


def validate_name(name):
    if not isinstance(name, str) or '\n' in name or '\r' in name:
        raise ValueError('Session name must be one line')
    parts = name.split(' > ')
    if len(parts) != 3 or not all(parts):
        raise ValueError(f'Invalid session name: {name!r}')
    if len(parts[2].split()) >= 10:
        raise ValueError(f'Session topic must contain fewer than 10 words: {parts[2]!r}')


def unchanged(path, decision, current):
    try:
        data = path.read_bytes()
        stat = path.stat()
    except OSError as error:
        return False, str(error)

    size = decision.get('size')
    mtime_ns = decision.get('mtime_ns')
    digest = decision.get('sha256')
    if not isinstance(size, int) or not isinstance(mtime_ns, int) or not isinstance(digest, str):
        return False, 'missing inspection guard'

    if path == current:
        if len(data) < size or hashlib.sha256(data[:size]).hexdigest() != digest:
            return False, 'changed since inspection'
    elif stat.st_size != size or stat.st_mtime_ns != mtime_ns or hashlib.sha256(data).hexdigest() != digest:
        return False, 'changed since inspection'

    return True, None


def trash_command():
    for command in ('trash', 'trash-put'):
        executable = shutil.which(command)
        if executable:
            return [executable]
    executable = shutil.which('gio')
    return [executable, 'trash'] if executable else None


def append_name(path, name):
    session = parse_session(path, include_content=False)
    if session['name']:
        raise RuntimeError('already named')

    record = {
        'type': 'session_info',
        'id': secrets.token_hex(4),
        'parentId': session['latest_id'],
        'timestamp': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
        'name': name,
    }
    with path.open('a', encoding='utf-8') as output:
        output.write(json.dumps(record, ensure_ascii=False, separators=(',', ':')) + '\n')
        output.flush()
        os.fsync(output.fileno())


def apply_plan():
    directory, current = session_context()
    try:
        plan = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        fail(f'Invalid cleanup plan: {error}')

    trash = plan.get('trash', [])
    rename = plan.get('rename', [])
    if not isinstance(trash, list) or not isinstance(rename, list):
        fail('Plan fields trash and rename must be arrays')

    decisions = {}
    try:
        for action, entries in (('trash', trash), ('rename', rename)):
            for entry in entries:
                path = candidate_path(directory, entry.get('file'))
                if path.name in decisions:
                    raise ValueError(f'Duplicate decision for {path.name}')
                if action == 'trash' and path == current:
                    raise ValueError('Current session may not be trashed')
                if action == 'trash' and not str(entry.get('reason', '')).strip():
                    raise ValueError(f'Missing trash reason for {path.name}')
                if action == 'rename':
                    validate_name(entry.get('name'))
                decisions[path.name] = (action, entry, path)
    except (AttributeError, TypeError, ValueError) as error:
        fail(str(error))

    unnamed_now = set()
    uncertain = []
    for path in sorted(directory.glob('*.jsonl')):
        try:
            if not parse_session(path, include_content=False)['name']:
                unnamed_now.add(path.name)
        except (OSError, RuntimeError) as error:
            uncertain.append({'file': path.name, 'reason': str(error)})

    missing = unnamed_now - decisions.keys()
    unknown = decisions.keys() - unnamed_now
    if missing:
        fail(f'Missing decisions for unnamed sessions: {", ".join(sorted(missing))}')
    for filename in sorted(unknown):
        uncertain.append({'file': filename, 'reason': 'missing or named since inspection'})
        decisions.pop(filename)

    command = trash_command()
    trashed = []
    renamed = []
    not_removed = []

    for filename, (action, entry, path) in list(decisions.items()):
        if action != 'trash':
            continue
        safe, reason = unchanged(path, entry, current)
        if not safe:
            uncertain.append({'file': filename, 'reason': reason})
            continue
        if not command:
            not_removed.append({'file': filename, 'reason': entry['reason']})
            continue
        result = subprocess.run([*command, str(path)], capture_output=True, text=True)
        if result.returncode:
            uncertain.append({'file': filename, 'reason': result.stderr.strip() or 'trash command failed'})
            continue
        trashed.append({'file': filename, 'reason': entry['reason']})

    for filename, (action, entry, path) in decisions.items():
        if action != 'rename':
            continue
        safe, reason = unchanged(path, entry, current)
        if not safe:
            uncertain.append({'file': filename, 'reason': reason})
            continue
        try:
            append_name(path, entry['name'])
            verified = parse_session(path, include_content=False)['name']
        except (OSError, RuntimeError) as error:
            uncertain.append({'file': filename, 'reason': str(error)})
            continue
        if verified != entry['name']:
            uncertain.append({'file': filename, 'reason': 'rename verification failed'})
            continue
        renamed.append({'file': filename, 'name': entry['name']})

    print(json.dumps({
        'renamed': renamed,
        'trashed': trashed,
        'uncertain_kept': uncertain,
        'not_removed': not_removed,
    }, ensure_ascii=False, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest='command', required=True)
    inspect_parser = subparsers.add_parser('inspect', help='Inspect unnamed sessions as JSON')
    inspect_parser.add_argument('--pretty', action='store_true')
    subparsers.add_parser('apply', help='Apply a JSON cleanup plan from stdin')
    arguments = parser.parse_args()

    if arguments.command == 'inspect':
        inspect_sessions(arguments.pretty)
    else:
        apply_plan()


if __name__ == '__main__':
    main()
